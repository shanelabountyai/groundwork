# Local Postgres only. Seed data is synthetic; never point this at a cloud database.
DATABASE_URL="postgresql://USER@localhost:5432/groundwork_dev?connection_limit=10&pool_timeout=20"
SHADOW_DATABASE_URL="postgresql://USER@localhost:5432/groundwork_shadow"

# Vercel Blob (private store) for proof-of-service photos. Vercel injects this
# automatically once a Blob store is linked to the project; for local dev,
# `vercel env pull` or create a store in the dashboard and paste its token.
BLOB_READ_WRITE_TOKEN=

# Twilio (SMS) and Resend (email) for the notification outbox. Unset in local
# dev and e2e — drainOutbox falls back to logging instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OSRM-compatible routing server for real drive miles/minutes
# (src/routes/routing.ts). Unset in local dev and e2e — estimateDrive falls
# back to the straight-line estimate instead of calling out. The public demo
# (https://router.project-osrm.org) works for a quick check but is rate
# limited and unfit for production; self-host or use a hosted OSRM for real use.
OSRM_BASE_URL=

# Public base URL for sign-in links (e.g. https://groundwork.example.com).
# Never derived from the request's Host header. Defaults to http://localhost:3900.
APP_URL=

# Stripe (BO-4 invoicing). Test-mode keys (sk_test_…) for anything but a real
# deploy. Unset: sending an invoice refuses with "Stripe is not configured".
# The signing secret is the webhook endpoint's (whsec_…); locally,
# `stripe listen --forward-to localhost:3900/stripe/webhook` prints one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
