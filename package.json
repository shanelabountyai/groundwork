{
  "name": "groundwork",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "if [ -x \"$HOME/.claude/bin/swapcheck\" ]; then \"$HOME/.claude/bin/swapcheck\" --quiet; fi",
    "predev": "npm run preflight",
    "dev": "next dev -p 3900",
    "build": "next build",
    "start": "next start -p 3900",
    "postinstall": "prisma generate",
    "pretest": "npm run typecheck",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:test",
    "db:status": "prisma migrate status && dotenv -e .env.test -- prisma migrate status",
    "visits:generate": "dotenv -e .env -- tsx scripts/visits-generate.ts",
    "db:seed": "dotenv -e .env -- tsx scripts/seed.ts",
    "rain-day": "dotenv -e .env -- tsx scripts/rain-day.ts",
    "outbox:drain": "dotenv -e .env -- tsx scripts/outbox-drain.ts",
    "pretest:e2e": "npm run preflight",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "shots": "dotenv -e .env.test -- tsx scripts/seed.ts --reset && dotenv -e .env.test -- playwright test -c playwright.shots.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6",
    "vitest": "^2.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
