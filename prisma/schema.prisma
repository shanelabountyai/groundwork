// Groundwork — Evergreen Property Care field service. Synthetic data only.
//
// Coordinates are (lat, lng), in that order, everywhere. Range checks on both
// live in the init migration: for a Tulsa-area point a swapped pair puts
// latitude at -95, which the database refuses.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Crew {
  id         String      @id @default(cuid())
  name       String      @unique
  homeLat    Float
  homeLng    Float
  maxStops   Int
  maxMinutes Int
  agreements Agreement[]
  visits     Visit[]
  overrides  CapacityOverride[]
  users      User[]
  timeEntries TimeEntry[]
}

model ServiceType {
  id               String      @id @default(cuid())
  name             String      @unique
  estimatedMinutes Int
  agreements       Agreement[]
  jobs             Job[]
  visits           Visit[]
}

model Property {
  id            String      @id @default(cuid())
  address       String
  lat           Float
  lng           Float
  /// Gate codes, pets, "text on arrival" — shown on the crew's stop card.
  accessNotes   String      @default("")
  customerName  String
  customerPhone String
  customerEmail String?
  /// Whether an en_route transition writes an outbox notification for this property.
  notifyOnEnRoute Boolean @default(true)
  agreements    Agreement[]
  jobs          Job[]
  visits        Visit[]
  portalTokens  PortalToken[]
  portalSessions PortalSession[]
  invoices      Invoice[]
}

enum Frequency {
  weekly
  biweekly
  every_4_weeks
  one_time
}

/// A pattern. The Visit rows it generates are the source of truth.
model Agreement {
  id            String      @id @default(cuid())
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id])
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  crewId        String
  crew          Crew        @relation(fields: [crewId], references: [id])
  frequency     Frequency
  priceCents    Int
  startDate     DateTime    @db.Date
  paused        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  visits        Visit[]
}

/// One-off work: no pattern, no recurrence. Placing it creates exactly one
/// Visit, which carries the crew and date from then on (rule 5) — so the job
/// itself stores neither, and nothing here can go stale when the visit moves.
model Job {
  id            String      @id @default(cuid())
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id])
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  priceCents    Int
  /// Who placed it, by name — like CapacityOverride.by, not a User foreign key.
  createdBy     String
  createdAt     DateTime    @default(now())
  visits        Visit[]
}

enum VisitStatus {
  pending
  en_route
  completed
  skipped
}

/// Why a crew skipped a stop. Fixed list; `other` requires a note.
enum SkipReason {
  locked_gate
  dog_loose
  customer_request
  weather
  other
}

model Visit {
  id             String      @id @default(cuid())
  /// Exactly one of agreementId / jobId is set (checked in the migration).
  agreementId    String?
  agreement      Agreement?  @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  jobId          String?
  job            Job?        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  /// Copied from the origin at creation, so readers never branch on it; a
  /// trigger keeps them equal to the agreement's or job's, which never change.
  propertyId     String
  property       Property    @relation(fields: [propertyId], references: [id])
  serviceTypeId  String
  serviceType    ServiceType @relation(fields: [serviceTypeId], references: [id])
  /// The slot the pattern produced. Never changes, even when `date` does —
  /// the unique index on it is what makes generation idempotent.
  occurrenceDate DateTime    @db.Date
  /// Where the visit sits now.
  date           DateTime    @db.Date
  crewId         String
  crew           Crew        @relation(fields: [crewId], references: [id])
  status         VisitStatus @default(pending)
  /// Rescheduled: keeps its slot in the series, no longer follows the pattern.
  detached       Boolean     @default(false)
  /// Snapshot at generation, so a later price change cannot rewrite revenue history.
  priceCents     Int
  /// Dispatcher's drag order. Null on every visit of a day means the day is
  /// auto-ordered on read; any non-null means a person ordered it, and
  /// auto-order leaves it alone until re-requested. Cleared when a visit moves.
  routePosition  Int?
  /// Set by the state machine (src/visits/status.ts), never by hand.
  startedAt      DateTime?
  finishedAt     DateTime?
  skipReason     SkipReason?
  /// Completion or skip note from the crew.
  note           String?
  /// Paths under uploads/, relative to the project root.
  beforePhoto    String?
  afterPhoto     String?
  createdAt      DateTime    @default(now())
  notifications  Notification[]
  rescheduleRequests RescheduleRequest[]
  /// On at most one live invoice. Voiding an invoice releases its visits.
  invoiceId      String?
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id])

  @@unique([agreementId, occurrenceDate])
  @@unique([jobId, occurrenceDate])
  @@index([crewId, date])
  @@index([propertyId, date])
}

/// A dispatcher pushed a crew-day past its capacity on purpose. Append-only.
model CapacityOverride {
  id        String   @id @default(cuid())
  crewId    String
  crew      Crew     @relation(fields: [crewId], references: [id])
  date      DateTime @db.Date
  visitId   String
  /// Load the day would carry with the visit in it.
  stops     Int
  minutes   Int
  reason    String
  by        String
  createdAt DateTime @default(now())

  @@index([crewId, date])
}

enum RescheduleStatus {
  pending
  approved
  declined
}

/// A customer's over-capacity date pick (portal-UX PX-1). The visit itself is
/// already skipped; approval books it, decline leaves the skip standing.
model RescheduleRequest {
  id            String           @id @default(cuid())
  visitId       String
  visit         Visit            @relation(fields: [visitId], references: [id])
  requestedDate DateTime         @db.Date
  status        RescheduleStatus @default(pending)
  /// The dispatcher's reason, shown to the customer on a decline.
  note          String?
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?

  @@index([status])
}

enum Channel {
  sms
  email
}

/// Transactional outbox: written in the same transaction as the change it
/// announces, so a notice exists iff the change committed. Nothing sends yet;
/// a worker that delivers rows and stamps `sentAt` is the upgrade.
model Notification {
  id        String    @id @default(cuid())
  /// Null for a notice about something other than one visit (an invoice).
  visitId   String?
  visit     Visit?    @relation(fields: [visitId], references: [id])
  channel   Channel
  to        String
  body      String
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([sentAt])
}

enum UserRole {
  dispatcher
  crew
}

/// Who can sign in. A crew user acts as exactly one crew; the migration checks
/// role and crewId agree, and that there is somewhere to send a link.
model User {
  id          String       @id @default(cuid())
  name        String
  email       String?      @unique
  phone       String?      @unique
  role        UserRole
  crewId      String?
  crew        Crew?        @relation(fields: [crewId], references: [id])
  loginTokens LoginToken[]
  sessions    Session[]
  timeEntries TimeEntry[]
}

/// Magic-link token. Only its SHA-256 is stored; single use, short-lived.
model LoginToken {
  hash      String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, createdAt])
}

/// Signed-in session. The cookie holds the raw token; only its SHA-256 is stored.
model Session {
  hash      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

/// Customer portal magic-link token, same shape as LoginToken but scoped to a
/// property (v1 has no Customer/User account for the customer-facing side).
model PortalToken {
  hash       String    @id
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([propertyId, createdAt])
}

/// Signed-in portal session, same shape as Session but scoped to a property.
model PortalSession {
  hash       String   @id
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
}

enum InvoiceStatus {
  draft
  sent
  paid
  payment_failed
  refunded
  void
}

/// BO-4. One customer (property), one or more completed visits. Transitions
/// live in src/billing/invoice.ts; paid/payment_failed/refunded are written by
/// the Stripe webhook, except a dispatcher's out-of-band "mark paid".
model Invoice {
  id          String        @id @default(cuid())
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id])
  /// Sum of the visits' snapshotted prices, fixed when the invoice is built.
  amountCents Int
  status      InvoiceStatus @default(draft)
  createdBy   String
  createdAt   DateTime      @default(now())
  sentAt      DateTime?
  paidAt      DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?
  voidedAt    DateTime?
  /// Out-of-band payment ("check #1043"); null when Stripe collected it.
  paidNote    String?
  /// The one Checkout Session that may still be open for this invoice.
  stripeCheckoutSessionId String? @unique
  checkoutUrl             String?
  checkoutExpiresAt       DateTime?
  stripePaymentIntentId   String? @unique
  visits      Visit[]

  @@index([propertyId, status])
}

/// Stripe event ids already applied. Inserted in the same transaction as the
/// change, so a redelivered event hits the primary key and changes nothing.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime
}

/// BO-8. One shift for one person, clocked from their own session. Independent
/// of Visit.startedAt/finishedAt. The migration allows at most one open entry
/// per user and requires clockOut > clockIn.
model TimeEntry {
  id       String    @id @default(cuid())
  /// Null once the user is deleted — deleting is how access is revoked, and
  /// that must not erase hours already worked; `name` keeps the row legible.
  userId   String?
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name     String
  /// The crew they clocked in as, fixed at clock-in.
  crewId   String
  crew     Crew      @relation(fields: [crewId], references: [id])
  /// LocalDate of clockIn. A shift past midnight counts to the day it began.
  date     DateTime  @db.Date
  clockIn  DateTime
  clockOut DateTime?

  @@index([date])
}
